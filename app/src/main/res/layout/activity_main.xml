<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 学生信息：硬编码，运行时不可编辑（作业要求 2） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/student_info"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="#1976D2"
            android:padding="12dp"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="房贷计算器"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="帮您轻松规划房贷"
            android:textSize="14sp"
            android:textColor="#666"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- 贷款金额输入 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="贷款金额（万元）"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etLoanAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如：100"
            android:inputType="numberDecimal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp" />

        <!-- 年利率输入 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="年利率（%）"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etInterestRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如：4.2"
            android:inputType="numberDecimal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp" />

        <!-- 贷款年限 Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="贷款年限"
            android:textStyle="bold"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerTerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/loan_terms"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/btn_dropdown"
            android:padding="12dp" />

        <!-- 还款方式 RadioGroup -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="还款方式"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbEqualPayment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="等额本息（每月还款额相同）"
                android:checked="true"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbEqualPrincipal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="等额本金（每月本金相同，利息递减）"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- 附加选项 CheckBox -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="附加选项"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbIncludeInsurance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="包含房贷保险（月保费 0.05%）"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbShowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="在结果页展示前 12 期明细"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- ImageButton 装饰 + 计算按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/ibInfo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_dialog_info"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="说明" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="点击右侧按钮开始计算"
                android:textColor="#888"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开始计算"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_bg"
            android:padding="14dp" />

    </LinearLayout>
</ScrollView>
